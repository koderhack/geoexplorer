{
  "name": "geoexplorer-coming-soon",
  "version": "1.0.0",
  "private": true,
  "description": "GeoExplorer - tactical GIS coming soon interface (Next.js + React + Tailwind CSS)",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "build:ghpages": "node scripts/build-ghpages.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "latest",
    "postcss": "latest",
    "tailwindcss": "latest",
    "wrangler": "^4.118.0"
  }
}